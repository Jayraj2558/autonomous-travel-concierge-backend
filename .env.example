# TravelGuard AI — API server
PORT=4000
NODE_ENV=development

# Comma separated list of allowed browser origins. "*" allows any (demo default).
CORS_ORIGIN=*

# PostgreSQL. When omitted the API boots with an in-memory repository and the
# Admin → System Health panel reports persistence as "in-memory (demo)".
# DATABASE_URL=postgresql://travelguard:travelguard@localhost:5432/travelguard
DATABASE_SSL=false

# External service simulation (mock providers in server/src/mocks)
MOCK_LATENCY_MIN_MS=140
MOCK_LATENCY_MAX_MS=460
